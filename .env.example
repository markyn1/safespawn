# ===========================================
# SafeSpawn / Content Creator — Exemplo de variáveis
# Copie para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com credenciais.
# ===========================================

# --- Banco de dados MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=content_creator_db

# --- API / JWT (backend) — use uma chave longa e aleatória em produção ---
SECRET_KEY=

# --- OpenAI (obrigatório para análise e geração de copy) ---
OPENAI_API_KEY=

# --- Frontend (Next.js): URL base da API. Deixe vazio para usar http://localhost:8000/api ---
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Backend: URL base para links (downloads, etc.). Deixe vazio para http://localhost:8000 ---
# API_BASE_URL=http://localhost:8000
